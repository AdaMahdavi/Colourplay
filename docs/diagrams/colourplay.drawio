        <mxCell id="e6" value="Processed pixels" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="contrast" target="vga" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Completed bounds" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="bbox" target="vga" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="460"/><mxPoint x="1110" y="460"/></Array></mxGeometry></mxCell>
