direction: right

source: "Prepared Image Source\nInstructor harness" {
  style.fill: "#e1d5e7"
}
chip: "tt_um_colourplay" {
  io: "io\nInput Unit" {
    style.fill: "#fff2cc"
  }
  ipu: "ipu - Image Processing Unit" {
    style.fill: "#d5e8d4"
    detect: "colour_detect"
    hue: "hue"
    contrast: "contrast"
    bbox: "bbox"
    detect -> hue: "Original RGB + selection"
    hue -> contrast: "Colour"
    detect -> bbox: "Selection + coordinates"
  }
  vga: "vga\nVGA Output Unit\nRaster / request scheduling / staging\nOverlay / quantization / sync" {
    style.fill: "#dae8fc"
  }
  io -> ipu.detect: "Pixel channel + configuration"
  ipu.contrast -> vga: "Processed pixel channel"
  ipu.bbox -> vga: "Completed bounds"
  vga -> io: "Advance pixel requests" {
    style.stroke-dash: 3
  }
}
viewer: "VGA Display\nPlayground / simulator" {
  style.fill: "#e1d5e7"
}
source -> chip.io: "Two-beat RGB888 input"
chip.io -> source: "Request" {
  style.stroke-dash: 3
}
chip.vga -> viewer: "RGB222 + HSYNC + VSYNC"
note: "Proposed module hierarchy; child datapaths are student skeletons.\nIPU owns selective bypass/control around its colour units.\nImage storage remains in the harness, not on the chip." {
  shape: text
}
